# Postgres connection string (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://scripthub:scripthub@localhost:5432/scripthub?schema=public"

# URL of the frontend app - used for CORS and for redirecting back after Google sign-in
FRONTEND_URL="http://localhost:5173"

# Google OAuth 2.0 credentials (create one at https://console.cloud.google.com/apis/credentials).
# Add GOOGLE_CALLBACK_URL below as an authorized redirect URI on the OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Secret used to sign session tokens. Generate one with e.g. `openssl rand -hex 32`.
JWT_SECRET=""
