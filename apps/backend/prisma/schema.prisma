// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  google
}

enum UserRole {
  developer
  runner
}

enum RunStatus {
  pending
  running
  succeeded
  failed
  canceled
}

model User {
  id             String       @id @default(uuid())
  authProviderId String
  authProvider   AuthProvider
  name           String
  role           UserRole
  email          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scripts     Script[]     @relation("ScriptCreator")
  configItems ConfigItem[] @relation("ConfigItemCreator")
  runs        Run[]        @relation("RunExecutor")
}

model Script {
  id           String   @id @default(uuid())
  creatorId    String
  creator      User     @relation("ScriptCreator", fields: [creatorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  code         String
  name         String
  description  String
  paramsSchema Json
  resultType   String?

  runs               Run[]
  configDependencies ScriptConfigItemDependency[]
}

model ConfigItem {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation("ConfigItemCreator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  code        Json
  name        String
  description String

  scriptDependencies ScriptConfigItemDependency[]
}

model ScriptConfigItemDependency {
  scriptId     String
  configItemId String
  script       Script     @relation(fields: [scriptId], references: [id])
  configItem   ConfigItem @relation(fields: [configItemId], references: [id])

  @@id([scriptId, configItemId])
}

model Run {
  id         String    @id @default(uuid())
  scriptId   String
  script     Script    @relation(fields: [scriptId], references: [id])
  params     Json
  result     Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     RunStatus @default(pending)
  executorId String
  executor   User      @relation("RunExecutor", fields: [executorId], references: [id])
}
